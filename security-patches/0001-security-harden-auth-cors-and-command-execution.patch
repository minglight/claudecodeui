+# =============================================================================
+# SECURITY CONFIGURATION
+# =============================================================================
+
+# Required: set a strong random JWT secret (minimum 32 chars recommended)
+# Example: openssl rand -base64 48
+JWT_SECRET=replace-with-a-strong-random-secret
+
+# JWT expiration (e.g. 15m, 1h, 24h, 7d)
+JWT_EXPIRES_IN=24h
+
+# Authentication cookie settings
+AUTH_COOKIE_NAME=cloudcli_token
+AUTH_COOKIE_MAX_AGE_SECONDS=86400
+COOKIE_SAMESITE=lax
+COOKIE_SECURE=false
+
+# Optional: allow token in URL query (disabled by default for security)
+# ALLOW_LEGACY_QUERY_TOKEN=false
+
+# Optional: explicit CORS allowlist (comma-separated origins)
+# CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://your-host.ts.net:3001
+
+# Optional: platform bypass auth (disabled by default)
+# PLATFORM_BYPASS_AUTH=false
+# PLATFORM_BYPASS_KEY=replace-with-strong-bypass-key
+
 # Uncomment the following line if you have a custom claude cli path other than the default "claude"
 # CLAUDE_CLI_PATH=claude
 
