diff --git a/src/utils/api.js b/src/utils/api.js
index 326efe1..f3e3a76 100644
--- a/src/utils/api.js
+++ b/src/utils/api.js
@@ -22,6 +22,24 @@ export const authenticatedFetch = (url, options = {}) => {
       ...defaultHeaders,
       ...options.headers,
     },
+  }).then((response) => {
+    if (response.status === 401 || response.status === 403) {
+      // Token expired or invalid – clean up and force re-login
+      try {
+        localStorage.removeItem('auth-token');
+        sessionStorage.setItem('authError', 'Session expired, please sign in again.');
+      } catch (e) {
+        // ignore storage errors
+      }
+
+      if (!window.location.pathname.includes('/login')) {
+        window.location.href = '/login';
+      }
+
+      throw new Error('Unauthorized or expired session');
+    }
+
+    return response;
   });
 };
 
